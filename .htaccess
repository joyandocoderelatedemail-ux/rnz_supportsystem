# Directory Index - Landing page first
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
    # Prevent Nginx and browser proxy caching of HTML/PHP pages
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route /support to login.php
    RewriteRule ^support/?$ login.php [L,QSA]

    # If the request is not a real directory and a matching .php file exists, rewrite internally
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>
