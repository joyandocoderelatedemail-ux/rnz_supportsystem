# Directory Index - Landing page first
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
    # Prevent Nginx and browser proxy caching of HTML/PHP pages
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route /support to login.php
    RewriteRule ^support/?$ login.php [L,QSA]

    # 1. Strip .php extension from URL in browser address bar (External Redirect)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^?]+)\.php [NC]
    RewriteCond %1 !^index$
    RewriteCond %1 !^backend/index$
    RewriteRule ^ /%1 [R=302,L,QSA]

    # 2. Map extensionless URLs to their .php files internally
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*?)/?$ $1.php [L,QSA]
</IfModule>
